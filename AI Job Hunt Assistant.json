      "parameters": {
        "jsCode": "const seen = new Set($input.all().map(i => i.json.job_id));\nconst allJobs = $('Filter').all();\nconst fresh = allJobs.filter(i => !seen.has(i.json.job_id));\nreturn fresh;"
