    {
      "parameters": {
        "jsCode": "const jobs = $input.all().map(i => i.json);\nconst rows = jobs.map(j => `\n  <tr>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;\"><b>${j.title}</b><br/><span style=\"color:#666\">${j.company} — ${j.location || 'N/A'}</span></td>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;\">${j.apply_email ? `<a href=\"mailto:${j.apply_email}\">Apply by email</a>` : (j.apply_link ? `<a href=\"${j.apply_link}\">Apply link</a>` : 'No link available')}</td>\n  </tr>`).join('');\nconst html = `<h2>Today's AI Automation Engineer picks (${jobs.length})</h2><table style=\"width:100%;border-collapse:collapse;font-family:sans-serif;\">${rows}</table>`;\nreturn [{ json: { html, count: jobs.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
