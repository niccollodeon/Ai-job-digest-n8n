    {
      "parameters": {
        "jsCode": "const results = $input.first().json.data.jobs || [];\nreturn results.map(job => ({\n  json: {\n    job_id: job.job_id,\n    title: job.job_title,\n    company: job.employer_name,\n    location: [job.job_city, job.job_state, job.job_country].filter(Boolean).join(', '),\n    apply_link: job.job_apply_link || (job.apply_options && job.apply_options[0] && job.apply_options[0].apply_link) || null,\n    apply_email: (job.apply_options || []).find(o => o.publisher && o.publisher.toLowerCase().includes('email'))?.apply_link || null,\n    posted_at: job.job_posted_at_datetime_utc,\n    description: (job.job_description || '').slice(0, 300)\n  }\n}));"
      },
      "id": "de8e3b8b-5953-4ea3-b5b4-8ed270a9662e",
      "name": "Flatten Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "56b99c3c-341f-4082-b581-6077e9a2a245",
              "leftValue": "={{ new Date($json.posted_at).getTime() }}",
              "rightValue": "={{ Date.now() - 7*24*60*60*1000 }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
